MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1937610469}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ae03de8467806d4e981aa8faf71681b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueModalUIPrefab: {fileID: 1616042993929822690, guid: f3ef1c123fc70044f96b2c13bc81a66f, type: 3}
  isOpen: 0
  ObjectDestroyed: 0
  DialogueEnd: 0
  dialogues:
  - imagesSetting: []
    characterHighlightIndex: 0
    currentCharacterName: Head of Villager
    characterDialogue: Anya, welcome back. How is your training?
    onCurrentDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - imagesSetting: []
    characterHighlightIndex: 0
    currentCharacterName: Anya
    characterDialogue: Hi, sir. Thank you. My training went good.
    onCurrentDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - imagesSetting: []
    characterHighlightIndex: 0
    currentCharacterName: Head of Villager
    characterDialogue: Glad to hear that. How about the some errands i ask you?
    onCurrentDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - imagesSetting: []
    characterHighlightIndex: 0
    currentCharacterName: Anya
    characterDialogue: Ofcourse, i have bring what you asked
    onCurrentDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - imagesSetting: []
    characterHighlightIndex: 0
    currentCharacterName: Head of Villager
    characterDialogue: Ah thank you. You are always being helpful. I am very appreciate.
    onCurrentDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - imagesSetting: []
    characterHighlightIndex: 0
    currentCharacterName: Head of Villager
    characterDialogue: .....
    onCurrentDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - imagesSetting: []
    characterHighlightIndex: 0
    currentCharacterName: Head of Villager
    characterDialogue: So, you already make up your mind, huh.
    onCurrentDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - imagesSetting: []
    characterHighlightIndex: 0
    currentCharacterName: Head of Villager
    characterDialogue: Yes. I feel like i am ready to take the journey.
    onCurrentDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - imagesSetting: []
    characterHighlightIndex: 0
    currentCharacterName: Head of Villager
    characterDialogue: 'Haha... If you already make up your mind then i can''t really
      stop you. '
    onCurrentDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - imagesSetting: []
    characterHighlightIndex: 0
    currentCharacterName: Anya
    characterDialogue: Thank you sir. Thank you for your guidance until now. Im sure
      it will be useful in the journey.
    onCurrentDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - imagesSetting: []
    characterHighlightIndex: 0
    currentCharacterName: Head of Villager
    characterDialogue: 'humu... well well. Now you just comeback from your last training.
      You shall back to your house, clean yourself and get a rest. '
    onCurrentDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - imagesSetting: []
    characterHighlightIndex: 0
    currentCharacterName: Anya
    characterDialogue: 'Understood sir. '
    onCurrentDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  onDialogueEnded:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 590966636}
        m_TargetAssemblyTypeName: LevelManager, Assembly-CSharp
        m_MethodName: GoToScene
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: Temp_Ending
          m_BoolArgument: 0
        m_CallState: 2
